{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReportingObjectsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::northstar-example-reports-prod/reports/*"
    },
    {
      "Sid": "ListReportingPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::northstar-example-reports-prod",
      "Condition": {"StringLike": {"s3:prefix": ["reports/", "reports/*"]}}
    }
  ]
}
